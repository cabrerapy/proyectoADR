{
  "name": "@gym-adr/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "build:serverless": "node scripts/build-serverless.mjs",
    "build:serverless:direct": "open-next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:foundation && npm run test:unit",
    "test:foundation": "node --test tests/*.test.mjs",
    "test:unit": "vitest run",
    "test:e2e": "npm run build && node scripts/run-e2e.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.984.0",
    "@aws-sdk/client-secrets-manager": "3.984.0",
    "@aws-sdk/client-ssm": "3.984.0",
    "@aws-sdk/s3-request-presigner": "3.984.0",
    "@gym-adr/data-access": "0.1.0",
    "@gym-adr/domain": "0.1.0",
    "@gym-adr/validation": "0.1.0",
    "jose": "6.2.8",
    "next": "16.3.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@opennextjs/aws": "4.0.2",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "4.1.10"
  }
}
