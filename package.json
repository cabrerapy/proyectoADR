{
  "name": "gym-adr-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "infrastructure"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @gym-adr/web",
    "build": "npm run build --workspace @gym-adr/web",
    "check:boundaries": "node scripts/check-workspace-boundaries.mjs",
    "dynamodb:local:down": "node scripts/dynamodb-local/cli.mjs down",
    "dynamodb:local:smoke": "node scripts/dynamodb-local/cli.mjs smoke",
    "dynamodb:local:test": "node scripts/dynamodb-local/cli.mjs test",
    "dynamodb:local:up": "node scripts/dynamodb-local/cli.mjs up",
    "format:check": "node scripts/check-format.mjs",
    "lint": "npm run lint --workspace @gym-adr/web",
    "security:secrets": "node scripts/check-secrets.mjs",
    "synth": "npm run synth --workspace @gym-adr/infrastructure",
    "test:tooling": "node --test scripts/**/*.test.mjs",
    "test:data-access:integration": "node scripts/dynamodb-local/run-data-access-integration.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "check": "npm run format:check && npm run security:secrets && npm run check:boundaries && npm run lint && npm run typecheck && npm run test:tooling && npm test"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "3.984.0",
    "semver": "7.8.1",
    "vite": "7.3.3"
  },
  "overrides": {
    "sharp": {
      "semver": "7.8.1"
    }
  }
}
