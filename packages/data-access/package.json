{
  "name": "@gym-adr/data-access",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./testing": {
      "types": "./src/testing/repository-fixtures.ts",
      "default": "./src/testing/repository-fixtures.ts"
    }
  },
  "scripts": {
    "test": "vitest run --exclude src/**/*.integration.test.ts",
    "test:integration": "vitest run src/idempotency-repository.integration.test.ts src/user-repository.integration.test.ts src/financial-repositories.integration.test.ts src/scheduling-repositories.integration.test.ts src/operations-repositories.integration.test.ts src/membership-plan-repository.integration.test.ts",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.984.0",
    "@aws-sdk/lib-dynamodb": "3.984.0",
    "@gym-adr/domain": "0.1.0",
    "@gym-adr/shared": "0.1.0"
  },
  "devDependencies": {
    "vitest": "4.1.10"
  }
}
